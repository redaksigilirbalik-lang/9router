# ============================================================
# 9Router Lite (Vercel) — contoh environment variables
# Salin file ini menjadi .env untuk development lokal,
# dan set variabel yang sama di Vercel (Project > Settings > Env).
# ============================================================

# --- WAJIB DISARANKAN -----------------------------------------
# Key akses endpoint /v1 milikmu. Dipakai tools AI sebagai
# "API Key" saat mengarahkan base URL ke deployment ini.
# Tanpa ini, siapa pun yang tahu URL deployment bisa memakai
# upstream (dan key) milikmu!
PROXY_API_KEY=ganti-dengan-random-string-panjang

# --- Preset provider OpenAI-compatible ------------------------
# Cukup isi salah satu/beberapa; otomatis menjadi upstream.
# Urutan fallback default sesuai urutan preset ini, bisa diatur
# ulang lewat UPSTREAM_ORDER.

# OpenCode Free (zen) — akses model Claude/GPT gratis
# (dapat API key di https://opencode.ai — pakai akun opencode)
OPCODE_API_KEY=

# OpenRouter — agregator banyak model (bayar per token)
OPENROUTER_API_KEY=

# GLM (Zhipu AI) — murah, OpenAI-compatible
GLM_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Groq — gratis untuk banyak model open-weight
GROQ_API_KEY=

# SiliconFlow — murah, banyak model China
SILICONFLOW_API_KEY=

# Mistral AI
MISTRAL_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# --- Upstream kustom (alternatif preset) -----------------------
# 1) JSON array — kontrol penuh:
# UPSTREAMS=[{"id":"kiro","prefix":"kr","name":"Kiro","baseUrl":"https://.../v1","apiKey":"..."}]
# UPSTREAMS=

# 2) Atau variabel bernomor (hingga 20):
# UPSTREAM_1_URL=
# UPSTREAM_1_API_KEY=
# UPSTREAM_1_PREFIX=
# UPSTREAM_1_NAME=
# UPSTREAM_1_MODELS=model-a,model-b   (opsional, utk daftar /v1/models)

# --- Prioritas fallback -----------------------------------------
# Urutan percobaan upstream, contoh: "glm,opencode,openrouter"
UPSTREAM_ORDER=

# --- Lain-lain ---------------------------------------------------
# Model default kalau request tidak menyebut "model"
DEFAULT_MODEL=
